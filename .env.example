# Resin Configuration
# Copy this file to .env and adjust values

# Webhook URL - receives batched JSON events every 30 seconds
# Leave empty to disable webhook dispatching
WEBHOOK_URL=

# Dispatch interval in seconds (default: 30)
DISPATCH_INTERVAL=30

# Whitelisted IPs - comma or space separated list of IP addresses and/or
# CIDR ranges that are completely ignored. Connections from these sources are
# dropped at the earliest possible point and never generate events.
# Example: WHITELIST_IPS=192.168.1.10, 10.0.0.0/24, 203.0.113.5
WHITELIST_IPS=
