# Resin Configuration
# Copy this file to .env and adjust values

# Webhook URL - receives batched JSON events every 30 seconds
# Leave empty to disable webhook dispatching
WEBHOOK_URL=

# Dispatch interval in seconds (default: 30)
DISPATCH_INTERVAL=30

# Whitelisted IPs - comma or space separated list of IP addresses and/or
# CIDR ranges that are completely ignored. Connections from these sources are
# dropped at the earliest possible point and never generate events.
# Example: WHITELIST_IPS=192.168.1.10, 10.0.0.0/24, 203.0.113.5
WHITELIST_IPS=

# Whitelist IP masks - newline separated list of regular expressions matched
# against the source IP string of every request. A match drops the connection
# just like a whitelisted IP. Kept separate from WHITELIST_IPS so exact IP/CIDR
# matching is never mixed up with regex matching. Each line is one pattern, so
# commas inside a regex (e.g. quantifiers like {1,3}) are preserved.
# Example (whitelist any IP ending in .7):
# WHITELIST_IP_MASK=\.7$
WHITELIST_IP_MASK=
